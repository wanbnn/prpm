[project]
name = "{{PACKAGE_NAME}}"
version = "0.1.0"
description = "Uma aplicação PyReact criada com PRPM"
requires-python = ">=3.9"
dependencies = [
    "pyreact-framework>=1.0.5",
]

[project.optional-dependencies]
dev = [
    "pytest>=8.0",
]

[tool.pyreact]
entry = "src/app.py"
output = "dist"
dev_port = 3000
ssr = true
css_modules = false
source_maps = true

[tool.prpm.scripts]
dev = "python -m src.server"
build = "python -m src.build"
test = "python -m pytest"
generate = "pyreact generate"

[tool.pytest.ini_options]
testpaths = ["tests"]
addopts = "-q"

