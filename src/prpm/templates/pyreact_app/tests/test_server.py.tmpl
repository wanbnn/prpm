import src.server as server


def setup_function():
    server.TASKS[:] = server.fresh_tasks()


def test_toggle_task_changes_server_state():
    assert server.TASKS[1]["done"] is False
    changed = server.toggle_task(2)
    assert changed["done"] is True
    assert "Connect analytics events" in server.task_fragment("done")


def test_add_task_returns_a_pyreact_fragment():
    task = server.add_task("Document the release")
    assert task["title"] == "Document the release"
    assert "Document the release" in server.task_fragment()


def test_filters_only_open_tasks():
    html = server.task_fragment("open")
    assert "Review the final landing page" not in html
    assert "Connect analytics events" in html

