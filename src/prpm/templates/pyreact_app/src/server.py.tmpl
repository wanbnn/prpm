"""Small development server with PyReact SSR and fragment endpoints."""

import argparse
import json
import mimetypes
import threading
import webbrowser
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from pathlib import Path
from urllib.parse import urlparse

from pyreact import h, render_to_string

from src.app import render_document
from src.components import TaskList
from src.data import fresh_tasks

PUBLIC = Path(__file__).resolve().parents[1] / "public"
TASKS = fresh_tasks()
STATE_LOCK = threading.Lock()


def toggle_task(task_id):
    with STATE_LOCK:
        for task in TASKS:
            if task["id"] == task_id:
                task["done"] = not task["done"]
                return task
    return None


def add_task(title):
    title = " ".join(str(title).split()).strip()
    if not title:
        return None
    with STATE_LOCK:
        task = {
            "id": max((item["id"] for item in TASKS), default=0) + 1,
            "title": title[:100],
            "project": "Inbox",
            "assignee": "You",
            "initials": "YO",
            "tone": "violet",
            "done": False,
            "priority": "Medium",
        }
        TASKS.append(task)
    return task


def task_fragment(filter_name="all"):
    with STATE_LOCK:
        if filter_name == "open":
            selected = [task.copy() for task in TASKS if not task["done"]]
        elif filter_name == "done":
            selected = [task.copy() for task in TASKS if task["done"]]
        else:
            selected = [task.copy() for task in TASKS]
    return render_to_string(h(TaskList, {"tasks": selected}))


class AppHandler(BaseHTTPRequestHandler):
    server_version = "PRPMDevServer/1.0"

    def do_GET(self):
        path = urlparse(self.path).path
        if path == "/":
            return self._html(render_document(TASKS, live_reload=True))
        if path == "/api/tasks":
            return self._json({"html": task_fragment(self._query_filter())})
        if path == "/__prpm_reload.js":
            return self._javascript(RELOAD_SCRIPT)
        if path == "/__prpm_stamp":
            watched = [*PUBLIC.rglob("*"), *PUBLIC.parent.joinpath("src").rglob("*.py")]
            stamp = max((path.stat().st_mtime_ns for path in watched if path.is_file()), default=0)
            return self._text(str(stamp))
        if path in {"/app.js", "/styles.css", "/favicon.svg"}:
            return self._asset(path[1:])
        self.send_error(404, "Not found")

    def do_POST(self):
        path = urlparse(self.path).path
        payload = self._read_json()
        if payload is None:
            return
        if path == "/api/tasks/toggle":
            try:
                task_id = int(payload.get("id"))
            except (TypeError, ValueError):
                return self._json({"error": "Invalid task id"}, status=400)
            task = toggle_task(task_id)
            if task is None:
                return self._json({"error": "Task not found"}, status=404)
            return self._json({"task": task, "html": task_fragment(payload.get("filter", "all"))})
        if path == "/api/tasks":
            task = add_task(payload.get("title", ""))
            if task is None:
                return self._json({"error": "A title is required"}, status=400)
            return self._json({"task": task, "html": task_fragment(payload.get("filter", "all"))}, status=201)
        self.send_error(404, "Not found")

    def _query_filter(self):
        query = urlparse(self.path).query
        for part in query.split("&"):
            key, _, value = part.partition("=")
            if key == "filter" and value in {"all", "open", "done"}:
                return value
        return "all"

    def _read_json(self):
        try:
            length = int(self.headers.get("Content-Length", "0"))
            return json.loads(self.rfile.read(length) or b"{}")
        except (ValueError, json.JSONDecodeError):
            self._json({"error": "Invalid JSON"}, status=400)
            return None

    def _asset(self, name):
        path = PUBLIC / name
        if not path.is_file():
            return self.send_error(404, "Asset not found")
        content_type = mimetypes.guess_type(path.name)[0] or "application/octet-stream"
        data = path.read_bytes()
        self.send_response(200)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-cache")
        self.end_headers()
        self.wfile.write(data)

    def _html(self, value):
        self._send(value.encode(), "text/html; charset=utf-8")

    def _javascript(self, value):
        self._send(value.encode(), "text/javascript; charset=utf-8")

    def _text(self, value):
        self._send(value.encode(), "text/plain; charset=utf-8")

    def _json(self, value, status=200):
        self._send(json.dumps(value).encode(), "application/json; charset=utf-8", status)

    def _send(self, data, content_type, status=200):
        self.send_response(status)
        self.send_header("Content-Type", content_type)
        self.send_header("Content-Length", str(len(data)))
        self.send_header("Cache-Control", "no-store")
        self.end_headers()
        self.wfile.write(data)

    def log_message(self, pattern, *args):
        print(f"[dev] {self.address_string()} - {pattern % args}")


RELOAD_SCRIPT = """
let stamp = null;
setInterval(async () => {
  try {
    const response = await fetch('/__prpm_stamp', { cache: 'no-store' });
    const next = await response.text();
    if (stamp && next !== stamp) window.location.reload();
    stamp = next;
  } catch (_) {}
}, 1200);
"""


def run(port=3000, open_browser=True):
    server = ThreadingHTTPServer(("127.0.0.1", port), AppHandler)
    url = f"http://127.0.0.1:{port}"
    print(f"[OK] {{PROJECT_NAME}} is running at {url}", flush=True)
    print("     Press Ctrl+C to stop.", flush=True)
    if open_browser:
        threading.Timer(0.6, lambda: webbrowser.open(url)).start()
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\n[OK] Server stopped.")
    finally:
        server.server_close()


if __name__ == "__main__":
    parser = argparse.ArgumentParser(description="{{PROJECT_NAME}} development server")
    parser.add_argument("--port", type=int, default=3000)
    parser.add_argument("--no-open", action="store_true")
    options = parser.parse_args()
    run(options.port, not options.no_open)
