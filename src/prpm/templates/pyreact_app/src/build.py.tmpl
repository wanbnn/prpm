"""Generate a self-contained static production build."""

import shutil
from pathlib import Path

from src.app import render_document
from src.data import fresh_tasks


def build(output=Path("dist")):
    output = Path(output)
    if output.exists():
        shutil.rmtree(output)
    shutil.copytree("public", output)
    (output / "index.html").write_text(
        render_document(fresh_tasks(), live_reload=False),
        encoding="utf-8",
    )
    return output.resolve()


if __name__ == "__main__":
    destination = build()
    print(f"[OK] Production build created at {destination}")

