"""Aplicação e documento HTML renderizados no servidor pelo PyReact."""

from pyreact import h, render_to_string

from src.components import App


def render_app(tasks):
    """Render only the application fragment (useful for tests and APIs)."""
    return render_to_string(h(App, {"tasks": tasks}))


def render_document(tasks, *, live_reload=False):
    """Render a complete HTML document with a PyReact-generated body."""
    reload_script = '<script src="/__prpm_reload.js" defer></script>' if live_reload else ""
    return f"""<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <meta name="theme-color" content="#7567f8">
    <meta name="description" content="{{PROJECT_NAME}} — a PyReact dashboard">
    <title>{{PROJECT_NAME}} · Orbit</title>
    <link rel="icon" href="/favicon.svg" type="image/svg+xml">
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Manrope:wght@500;600;700;800&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="/styles.css">
    <script src="/app.js" defer></script>
    {reload_script}
  </head>
  <body>{render_app(tasks)}</body>
</html>
"""

