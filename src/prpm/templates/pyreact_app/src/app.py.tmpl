"""Entry point for the PyReact server-driven runtime."""

from pyreact import h, render_to_string
from pyreact.routing import routing_context

from src.components import App as DashboardApp


def App(props):
    """Public application component discovered by ``pyreact dev``."""
    return h(DashboardApp, props)


def render_app(path="/"):
    """Render a route to hydratable HTML for tests or custom adapters."""
    with routing_context(path):
        return render_to_string(h(App, {"path": path}))
